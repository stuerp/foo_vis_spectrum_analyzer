
/** $VER: FiltersPage.rc (2026.09.09) P. Stuer **/

#include "Resources.h"

#include <winres.h>

#include "FiltersPageLayout.h"

language LANG_ENGLISH, SUBLANG_ENGLISH_US
#pragma code_page(1252)

IDD_FILTERS_PAGE dialogex 0, 0, 0, 0
font 8, "MS Shell Dlg", 400, 0, 0x1
style DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
{
    groupbox "Acoustic Filters", IDC_FILTERS_GROUP, X_B09, Y_B09, W_B09, H_B09, BS_GROUPBOX, WS_EX_TRANSPARENT

        rtext           "Weighting type:",              IDC_STATIC,                     X_H01, Y_H01 + 2, W_H01, H_H01
        combobox                                        IDC_ACOUSTIC_FILTER,            X_H02, Y_H02,     W_H02, H_H02, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

        rtext           "Frequency shift:"              IDC_STATIC,                     X_H03, Y_H03 + 2, W_H03, H_H03
        edittext                                        IDC_FREQ_SHIFT,                 X_H04, Y_H04, W_H04, H_H04, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_FREQ_SHIFT_SPIN,            "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
        ltext           "bins"                          IDC_STATIC,                     X_H21, Y_H21 + 2, W_H21, H_H21

        rtext           "Frequency tilt:"               IDC_STATIC,                     X_H05, Y_H05 + 2, W_H05, H_H05
        edittext                                        IDC_FREQ_TILT,                  X_H06, Y_H06, W_H06, H_H06, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_FREQ_TILT_SPIN,             "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
        ltext           "dB/octave"                     IDC_STATIC,                     X_H07, Y_H07 + 2, W_H07, H_H07

        rtext           "Frequency tilt pivot:"         IDC_STATIC,                     X_H08, Y_H08 + 2, W_H08, H_H08
        edittext                                        IDC_FREQ_TILT_PIVOT,            X_H09, Y_H09, W_H09, H_H09, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_FREQ_TILT_PIVOT_SPIN,       "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
        ltext           "Hz"                            IDC_STATIC,                     X_H10, Y_H10 + 2, W_H10, H_H10

        rtext           "Equalization amount:"          IDC_STATIC,                     X_H11, Y_H11 + 2, W_H11, H_H11
        edittext                                        IDC_EQ_AMT,                     X_H12, Y_H12, W_H12, H_H12, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_EQ_AMT_SPIN,                "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0

        rtext           "Equalization frequency scale:" IDC_STATIC,                     X_H13, Y_H13 + 2, W_H13, H_H13
        edittext                                        IDC_EQ_OFFS,                    X_H14, Y_H14, W_H14, H_H14, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_EQ_OFFS_SPIN,               "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
        ltext           "Hz"                            IDC_STATIC,                     X_H15, Y_H15 + 2, W_H15, H_H15

        rtext           "Equalization depth:"           IDC_STATIC,                     X_H16, Y_H16 + 2, W_H16, H_H16
        edittext                                        IDC_EQ_DEPTH,                   X_H17, Y_H17, W_H17, H_H17, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_EQ_DEPTH_SPIN,              "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
        ltext           "Hz"                            IDC_STATIC,                     X_H18, Y_H18 + 2, W_H18, H_H18

        rtext           "Weighting amount:"             IDC_STATIC,                     X_H19, Y_H19 + 2, W_H19, H_H19
        edittext                                        IDC_WT_AMT,                     X_H20, Y_H20, W_H20, H_H20, ES_RIGHT | ES_AUTOHSCROLL | WS_TABSTOP
        control         "",                             IDC_WT_AMT_SPIN,                "msctls_updown32", UDS_ALIGNRIGHT | UDS_ARROWKEYS | UDS_AUTOBUDDY | UDS_NOTHOUSANDS, 0, 0, 0, 0
}
